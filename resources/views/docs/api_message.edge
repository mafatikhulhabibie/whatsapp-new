              @!docs.param_row({ name: '/api/device/stop', type: 'POST', required: false, desc: 'Stop sesi tanpa hapus auth' })
              @!docs.param_row({ name: '/api/device/logout', type: 'POST', required: false, desc: 'Logout &amp; hapus sesi' })
            @end
          @end

          @!docs.endpoint({
            id: 'device-start',
            title: 'Mulai Sesi QR Code',
            method: 'POST',
            url: baseUrl + '/api/device/start',
            description: 'Memulai sesi koneksi. Setelah ini, polling <code class="text-xs">/status</code> untuk mendapatkan QR code.'
          })
            @!docs.param_table({})
              @!docs.param_row({ name: 'token', type: 'string', required: true, desc: 'Token device' })
            @end
            <div>
              <div class="text-xs font-semibold uppercase tracking-wide text-cat-500 mb-2">Contoh PHP</div>
              <pre class="text-[0.85rem] p-0"><code class="language-php">&lt;?php
