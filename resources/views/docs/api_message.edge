                <p>Base URL API:</p>
                <code class="block text-xs select-all bg-cat-100 dark:bg-cat-900/50 rounded-lg px-3 py-2">{{ baseUrl }}/api</code>
                <p>Semua request menggunakan <strong>Content-Type: application/json</strong> dan method <strong>POST</strong> (kecuali disebutkan lain).</p>
                <p>Token device didapat dari menu <strong>Device Connection</strong> setelah membuat device.</p>
              </div>
            @end

            @card({ class: 'p-5 mt-4' })
              <div class="text-sm font-semibold mb-3">Alur Integrasi</div>
              <ol class="text-sm space-y-2 text-cat-700 dark:text-cat-300 list-decimal list-inside">
                <li>Salin <strong>Helper PHP</strong> ke project Anda</li>
                <li>Hubungkan device via <strong>Scan QR Code</strong> (start → polling status)</li>
                <li>Pastikan status device = <code class="text-xs">connected</code></li>
                <li>Kirim pesan via <strong>Send Message API</strong></li>
                <li>Opsional: jadwalkan pesan via <strong>Schedule API</strong></li>
              </ol>
            @end
          @end

        {{-- 2. Helper PHP --}}
        @!docs.section({
          id: 'helper-php',
          number: '2',
          title: 'Helper PHP',
          description: 'Salin file helper ini terlebih dahulu. Semua contoh di dokumentasi menggunakan fungsi-fungsi berikut.'
        })
          @card({ class: 'overflow-hidden' })
            <div class="border-b border-cat-200 dark:border-cat-700 px-5 py-3 bg-cat-50/50 dark:bg-cat-900/30">
              <div class="text-xs font-semibold uppercase tracking-wide text-cat-500">wa_helper.php</div>
            </div>
            <pre class="text-[0.85rem] p-5 overflow-x-auto"><code class="language-php">&lt;?php
function waApiRequest(string $url, array $payload): array
{
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_POST           =&gt; true,
        CURLOPT_HTTPHEADER     =&gt; ['Content-Type: application/json'],
        CURLOPT_POSTFIELDS     =&gt; json_encode($payload),
        CURLOPT_RETURNTRANSFER =&gt; true,
        CURLOPT_TIMEOUT        =&gt; 30,
    ]);

    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    return [
        'status' =&gt; $httpCode,
        'body'   =&gt; json_decode($response, true),
    ];
}

/** Kirim pesan langsung */
function sendWaMessage(array $payload): array
{
    return waApiRequest('{{ baseUrl }}/api/message', $payload);
}

/** Jadwalkan pesan */
function scheduleWaMessage(array $payload): array
{
    return waApiRequest('{{ baseUrl }}/api/message/schedule', $payload);
}

/** Request ke endpoint device (start, status, stop, logout) */
function waDeviceRequest(string $endpoint, array $payload): array
{
    return waApiRequest('{{ baseUrl }}/api/device/' . $endpoint, $payload);
}</code></pre>
          @end

          @!docs.param_table({ title: 'Fungsi Helper' })
            @!docs.param_row({ name: 'waApiRequest()', type: 'function', required: false, desc: 'Request HTTP POST ke API WAPI' })
