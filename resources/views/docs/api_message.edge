$result = scheduleWaMessage([
    'token'       =&gt; 'TOKEN_DEVICE',
    'to'          =&gt; '628123456789',
    'message'     =&gt; 'Pesan terjadwal',
    'scheduledAt' =&gt; '2026-06-12T14:30:00.000Z',
]);

// $result['body']['data']['id']           → ID jadwal
// $result['body']['data']['scheduledAt'] → waktu jadwal</code></pre>
