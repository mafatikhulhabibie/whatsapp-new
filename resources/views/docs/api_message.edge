    'token' =&gt; 'TOKEN_DEVICE',
]);</code></pre>
            </div>
          @end

          @!docs.endpoint({
            id: 'device-status',
            title: 'Polling Status & QR Code',
            method: 'POST',
            url: baseUrl + '/api/device/status',
            description: 'Poll setiap <strong>2–3 detik</strong>. Field <code class="text-xs">connection.qr</code> berisi QR dalam format data URL (base64). Status <code class="text-xs">connected</code> = berhasil scan.'
          })
            @!docs.param_table({})
              @!docs.param_row({ name: 'token', type: 'string', required: true, desc: 'Token device' })
            @end
            <div>
              <div class="text-xs font-semibold uppercase tracking-wide text-cat-500 mb-2">Contoh PHP</div>
              <pre class="text-[0.85rem] p-0"><code class="language-php">&lt;?php
$result = waDeviceRequest('status', ['token' =&gt; 'TOKEN_DEVICE']);
$data   = $result['body']['data'] ?? [];

// Tampilkan QR:
// echo '&lt;img src="' . ($data['connection']['qr'] ?? '') . '"&gt;';

// Field penting:
// $data['status']                          → connecting | connected
// $data['connection']['qr']                → data:image/png;base64,...
// $data['connection']['pairingCode']       → null atau kode pairing</code></pre>
            </div>
          @end

          @!docs.endpoint({
            id: 'device-pairing',
            title: 'Pairing Code (Alternatif QR)',
            method: 'POST',
            url: baseUrl + '/api/device/start',
            description: 'Gunakan pairing code jika tidak ingin scan QR. Masukkan kode di WhatsApp → Linked Devices.'
          })
            @!docs.param_table({})
              @!docs.param_row({ name: 'token', type: 'string', required: true, desc: 'Token device' })
              @!docs.param_row({ name: 'usePairingCode', type: 'boolean', required: false, desc: 'Set <code class="text-xs">true</code> untuk pairing code' })
            @end
            <div>
              <div class="text-xs font-semibold uppercase tracking-wide text-cat-500 mb-2">Contoh PHP</div>
              <pre class="text-[0.85rem] p-0"><code class="language-php">&lt;?php
waDeviceRequest('start', [
    'token'          =&gt; 'TOKEN_DEVICE',
    'usePairingCode' =&gt; true,
]);

$status = waDeviceRequest('status', ['token' =&gt; 'TOKEN_DEVICE']);
$code   = $status['body']['data']['connection']['pairingCode'] ?? null;</code></pre>
            </div>
          @end

