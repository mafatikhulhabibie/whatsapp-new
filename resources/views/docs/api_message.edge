            @!docs.param_row({ name: 'scheduleWaMessage()', type: 'function', required: false, desc: 'Jadwalkan pesan untuk dikirim otomatis' })
            @!docs.param_row({ name: 'waDeviceRequest()', type: 'function', required: false, desc: 'Kelola koneksi device (QR / pairing)' })
          @end
        @end

        {{-- 3. Device API --}}
        @!docs.section({
          id: 'device-api',
          number: '3',
          title: 'Device & Scan QR Code',
          description: 'Hubungkan WhatsApp ke WAPI via scan QR code atau pairing code.'
        })

          @card({ class: 'p-5 mb-2' })
            @!docs.param_table({ title: 'Daftar Endpoint Device' })
              @!docs.param_row({ name: '/api/device/start', type: 'POST', required: false, desc: 'Mulai sesi koneksi (QR / pairing)' })
