@layouts.simple.app({
  title: '404'
})
  <div class="absolute inset-0 flex items-center justify-center text-[15rem] sm:text-[20rem] md:text-[30rem] lg:text-[35rem] font-bold opacity-3 overflow-hidden">
    404
  </div>

  <div class="min-h-svh flex items-center justify-center flex-col p-5 relative z-10">
    <div class="mx-auto max-w-md">
      <div class="font-bold text-2xl mb-5">
        Page not found!
      </div>
      <div class="text-cat-600 dark:text-cat-400 text-sm">Sorry, we couldn’t find the page you’re looking for. Perhaps you’ve mistyped the URL? Be sure to check your spelling.</div>
    </div>
  </div>
@end
