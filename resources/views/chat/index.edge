@layouts.dash.app({
  title: 'CHAT'
})

  <div class="lazy-container-sm">
    <section class="flex flex-row flex-wrap justify-between mb-5 gap-5">
      <div>
        <div class="text-lg font-bold">Chat</div>
        <div class="text-sm text-cat-600 dark:text-cat-400">
          Pilih device untuk melihat pesan masuk dan keluar WhatsApp.
        </div>
      </div>
    </section>

    <section>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        @each(device in devices)
          <a
            href="{{ route('chat.show', [ device.id ]) }}"
            class="block rounded-2xl overflow-hidden shadow border border-cat-200 dark:border-cat-700 bg-white dark:bg-cat-800 transition hover:shadow-md"
          >
            <div class="p-5">
              <div class="text-sm font-semibold mb-1">{{ device.name }}</div>
              <div class="text-xs text-cat-500 mb-3">{{ device.number }}</div>
              @if(device.status === 'connected')
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">Connected</span>
              @else
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-cat-100 text-cat-700 dark:bg-cat-700 dark:text-cat-300">{{ device.status }}</span>
              @end
            </div>
          </a>
        @end
      </div>
    </section>
  </div>

@end
