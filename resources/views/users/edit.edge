@layouts.dash.app({
  title: 'EDIT USER'
})

  <div class="lazy-container-sm">
    <section class="flex flex-row flex-wrap justify-between mb-10 gap-5">
      <div>
        <div class="text-2xl font-bold">
          Edit User
        </div>
        <div class="text-sm text-cat-600 dark:text-cat-400 max-w-xl">
          Perbarui data user dan role akses
        </div>
      </div>
      <div>
        @button({
          href: route('users.index'),
          variant: 'outline'
        })
          Kembali
        @end
      </div>
    </section>

    <section>
      @card({ class: 'p-5' })
        @form({
          id: 'form-user-admin-update',
          method: 'POST',
          action: route('users.adminUpdate', [ user.id ]),
        })
          {{ (typeof csrfField === 'function') ? csrfField() : '' }}

          <div class="mb-3">
            @!label({ for: 'name', label: 'Nama' })
            @!input({
              name: 'name',
              value: user.name,
              id: 'name',
              required: true,
              placeholder: 'Nama lengkap'
            })
          </div>

          <div class="flex gap-3 flex-col md:flex-row w-full mb-3">
            <div class="w-full">
              @!label({ for: 'username', label: 'Username' })
              @!input({
                name: 'username',
                value: user.username,
                id: 'username',
                required: true,
                placeholder: 'Username',
                oninput: "this.value = this.value.toLowerCase().replace(/ /g, '').replace(/[^a-z0-9_-]/g, '');"
              })
            </div>
            <div class="w-full">
              @!label({ for: 'password', label: 'Password' })
              @!input({
                name: 'password',
                id: 'password',
                placeholder: 'Password',
              })
              <div class="text-xs text-cat-600 dark:text-cat-400 mt-1">Kosongkan jika tidak ingin mengubah password</div>
            </div>
          </div>

          <div class="flex gap-3 flex-col md:flex-row w-full mb-3">
            <div class="w-full">
              @!label({ for: 'role', label: 'Role' })
              <select
                name="role"
                id="role"
                required
                class="appearance-none block w-full px-3 py-2.5 text-sm rounded-md focus:ring-[1.7px] focus:outline-none focus:ring-cat-700 dark:focus:ring-cat-200 focus:border-transparent transition duration-150 ease-in-out bg-white dark:bg-cat-700/10 border border-cat-300 dark:border-cat-700/50"
              >
                <option value="user" @if(user.role === 'user') selected @end>User</option>
                <option value="admin" @if(user.role === 'admin') selected @end>Admin</option>
              </select>
            </div>
            <div class="w-full">
              @!label({ for: 'maxDevices', label: 'Max Device' })
              @!input({
                type: 'number',
                name: 'maxDevices',
                id: 'maxDevices',
                value: user.maxDevices,
                min: '0',
                max: '100',
                required: true
              })
            </div>
          </div>

          <div class="text-end">
            @button({ type: 'submit' })
              Simpan
            @end
          </div>
        @end
      @end
    </section>
  </div>

@end

@pushTo('body')
  <script>
    window.addEventListener('form', ({ detail }) => {
      if (detail.id != 'form-user-admin-update') return

      if (detail?.ok) {
        detail.element.target.querySelector('#password').value = ''
      }
    })
  </script>
@end
