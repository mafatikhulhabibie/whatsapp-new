<header class="lazy-header">
  <nav>
    <div class="lg:hidden mr-3">
      @button({
          variant: 'ghost',
          size: 'icon',
          class: '!rounded-full',
          'x-data': '{}',
          'x-on:click': '$store.sidebar.toggle()'
        })
        <svg class="size-5 text-cat-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
          <defs><style></style></defs>
          <path
            fill="currentColor"
            class="fa-secondary"
            d="M64 256c0-17.7 14.3-32 32-32H480c17.7 0 32 14.3 32 32s-14.3 32-32 32H96c-17.7 0-32-14.3-32-32z"
          />
          <path
            fill="currentColor"
            class="fa-primary"
            d="M448 96c0-17.7-14.3-32-32-32H32C14.3 64 0 78.3 0 96s14.3 32 32 32H416c17.7 0 32-14.3 32-32zm0 320c0-17.7-14.3-32-32-32H32c-17.7 0-32 14.3-32 32s14.3 32 32 32H416c17.7 0 32-14.3 32-32z"
          />
        </svg>
      @end
    </div>

    <div class="lazy-header-icon">
      <div x-data>
        <div data-ws-badges>
          @badge({ class: 'bg-emerald-500/20 text-emerald-600 dark:bg-emerald-500/30 dark:text-emerald-300 !rounded-full', variant: 'none', 'data-ws-badge': 'connected', style: 'display: none' })
            <svg class="size-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewbox="0,0,576,512"><path d="M0 256C0 167.6 71.6 96 160 96l72 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-72 0C98.1 144 48 194.1 48 256s50.1 112 112 112l72 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-72 0C71.6 416 0 344.4 0 256zm576 0c0 88.4-71.6 160-160 160l-72 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l72 0c61.9 0 112-50.1 112-112s-50.1-112-112-112l-72 0c-13.3 0-24-10.7-24-24s10.7-24 24-24l72 0c88.4 0 160 71.6 160 160zM184 232l208 0c13.3 0 24 10.7 24 24s-10.7 24-24 24l-208 0c-13.3 0-24-10.7-24-24s10.7-24 24-24z" fill="currentColor" style="opacity: 1;"></path></svg>
            <span class="hidden md:block mr-1">WS -</span> Connected
          @end
          @badge({ class: 'bg-red-500/20 text-red-600 dark:bg-red-500/30 dark:text-red-300 !rounded-full', variant: 'none', 'data-ws-badge': 'disconnected', style: 'display: none' })
            <svg class="size-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewbox="0,0,640,512"><path d="M25.9 3.4C19-2 8.9-.8 3.4 6.1S-.8 23.1 6.1 28.6l608 480c6.9 5.5 17 4.3 22.5-2.6s4.3-17-2.6-22.5L25.9 3.4zM608 256c0-88.4-71.6-160-160-160l-80 0c-8.8 0-16 7.2-16 16s7.2 16 16 16l80 0c70.7 0 128 57.3 128 128c0 35.5-14.4 67.6-37.7 90.8l25.3 19.9C591.1 338 608 299 608 256zM456 272c8.8 0 16-7.2 16-16s-7.2-16-16-16l-53 0 40.5 32 12.4 0zM196.4 240L184 240c-8.8 0-16 7.2-16 16s7.2 16 16 16l53 0-40.5-32zm-94.7-74.8L76.5 145.3C48.9 174 32 213 32 256c0 88.4 71.6 160 160 160l80 0c8.8 0 16-7.2 16-16s-7.2-16-16-16l-80 0c-70.7 0-128-57.3-128-128c0-35.5 14.4-67.6 37.7-90.8z" fill="currentColor" style="opacity: 1;"></path></svg>
            <span class="hidden md:block mr-1">WS -</span> Disconnected
          @end
        </div>
      </div>
      <div class="flex gap-1 items-center">

        @button({
          variant: 'ghost',
          size: 'icon',
          class: '!rounded-full relative',
          'x-data': '{}',
          'x-sheet:toggle': 'lazySettings'
        })
          <svg
            class="size-6 motion-rotate-loop-[1turn]/reset motion-ease-linear motion-duration-[10s] text-cat-500"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              fill-rule="evenodd"
              d="M14.279 2.152C13.909 2 13.439 2 12.5 2s-1.408 0-1.779.152a2 2 0 0 0-1.09 1.083c-.094.223-.13.484-.145.863a1.62 1.62 0 0 1-.796 1.353a1.64 1.64 0 0 1-1.579.008c-.338-.178-.583-.276-.825-.308a2.03 2.03 0 0 0-1.49.396c-.318.242-.553.646-1.022 1.453c-.47.807-.704 1.21-.757 1.605c-.07.526.074 1.058.4 1.479c.148.192.357.353.68.555c.477.297.783.803.783 1.361s-.306 1.064-.782 1.36c-.324.203-.533.364-.682.556a2 2 0 0 0-.399 1.479c.053.394.287.798.757 1.605s.704 1.21 1.022 1.453c.424.323.96.465 1.49.396c.242-.032.487-.13.825-.308a1.64 1.64 0 0 1 1.58.008c.486.28.774.795.795 1.353c.015.38.051.64.145.863c.204.49.596.88 1.09 1.083c.37.152.84.152 1.779.152s1.409 0 1.779-.152a2 2 0 0 0 1.09-1.083c.094-.223.13-.483.145-.863c.02-.558.309-1.074.796-1.353a1.64 1.64 0 0 1 1.579-.008c.338.178.583.276.825.308c.53.07 1.066-.073 1.49-.396c.318-.242.553-.646 1.022-1.453c.47-.807.704-1.21.757-1.605a2 2 0 0 0-.4-1.479c-.148-.192-.357-.353-.68-.555c-.477-.297-.783-.803-.783-1.361s.306-1.064.782-1.36c.324-.203.533-.364.682-.556a2 2 0 0 0 .399-1.479c-.053-.394-.287-.798-.757-1.605s-.704-1.21-1.022-1.453a2.03 2.03 0 0 0-1.49-.396c-.242.032-.487.13-.825.308a1.64 1.64 0 0 1-1.58-.008a1.62 1.62 0 0 1-.795-1.353c-.015-.38-.051-.64-.145-.863a2 2 0 0 0-1.09-1.083"
              clip-rule="evenodd"
              opacity="0.4"
            />
            <path
              fill="currentColor"
              d="M15.523 12c0 1.657-1.354 3-3.023 3s-3.023-1.343-3.023-3S10.83 9 12.5 9s3.023 1.343 3.023 3"
            />
          </svg>
          <span
            class="absolute top-2 end-2 inline-flex items-center size-2 rounded-full font-medium transform -translate-y-1/2 translate-x-1/2 bg-red-500 text-white dark:border-slate-900 animate-pulse"
          ></span>
        @end
        @dropdown({ class: 'ml-2' })
          @dropdown.trigger({ variant: 'outline' })
            <img class="cursor-pointer size-9 rounded-full overflow-hidden object-center object-cover" src="/lazy/image/avatar.webp" alt="avatar">
          @end
          @dropdown.content({ class: 'w-40', align: 'end' })
            @dropdown.label()
              My Account
            @end
            @!dropdown.separator()
            @dropdown.link({ href: route('users.show', [ auth.user.id ]) })
              Settings
            @end
            @!dropdown.separator()
            @dropdown.link({ href: route('logout') })
              Log out
            @end
          @end
        @end

      </div>
    </div>
  </nav>
</header>
